<html lang="en" vid="0"><head vid="1">
    <meta charset="UTF-8" vid="2">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" vid="3">
    <title vid="4">Stella Matutina</title>
    <style vid="5">
        :root {
            --paper: #f2f2f2;
            --ink: #0d0d0d;
            --cyan: #00aeef;
            --magenta: #ec008c;
            --yellow: #fff200;
            --grid-unit: 1rem;
            --font-main: "Helvetica Neue", Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background-color: #050505; 
            font-family: var(--font-main);
            color: var(--ink);
            height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        
        #deck-container {
            width: 90vw;
            height: 90vh;
            max-width: 1400px;
            background-color: var(--paper);
            position: relative;
            display: grid;
            grid-template-columns: 45% 1fr;
            overflow: hidden;
            box-shadow: 0 0 50px rgba(0,0,0,0.5);
        }

        
        .visual-panel {
            border-right: 1px solid var(--ink);
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2rem;
            overflow: hidden;
        }

        .visual-panel::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(#0d0d0d 1px, transparent 1px),
                radial-gradient(#0d0d0d 1px, transparent 1px);
            background-size: 4px 4px;
            background-position: 0 0, 2px 2px;
            opacity: 0.1;
            pointer-events: none;
            z-index: 0;
        }

        
        .halftone-figure {
            position: relative;
            width: 100%;
            height: 60%;
            background: #ccc;
            overflow: hidden;
            margin-top: 4rem;
            /* full colour */
        }

        .halftone-figure img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            mix-blend-mode: multiply;
        }

        .halftone-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle, var(--ink) 20%, transparent 25%);
            background-size: 6px 6px; 
            opacity: 0.08;
            mix-blend-mode: overlay;
        }

        
        .color-bars {
            display: flex;
            flex-direction: column;
            width: 10px;
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            gap: 2px;
        }
        .c-bar { width: 100%; height: 40px; }
        .bg-c { background: var(--cyan); }
        .bg-m { background: var(--magenta); }
        .bg-y { background: var(--yellow); }
        .bg-k { background: var(--ink); }

        .reg-mark {
            position: absolute;
            width: 20px;
            height: 20px;
            border: 1px solid var(--ink);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .reg-mark::after, .reg-mark::before {
            content: "";
            position: absolute;
            background: var(--ink);
        }
        .reg-mark::after { width: 1px; height: 100%; }
        .reg-mark::before { height: 1px; width: 100%; }

        .rm-tl { top: 1rem; left: 1rem; }
        .rm-br { bottom: 1rem; right: 1rem; }

        .meta-data {
            font-size: 0.75rem;
            font-family: "Courier New", Courier, monospace;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            z-index: 2;
        }

        
        .content-panel {
            position: relative;
            overflow-y: scroll;
            scroll-behavior: smooth;
            
            scrollbar-width: none; 
            -ms-overflow-style: none;
            padding: 0;
        }
        .content-panel::-webkit-scrollbar { 
            width: 0; 
            height: 0; 
        }

        section {
            min-height: 100%;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-bottom: 1px dashed var(--ink);
            position: relative;
        }

        
        h1 {
            font-size: 4.5rem;
            line-height: 0.9;
            font-weight: 400; 
            letter-spacing: -0.03em;
            margin-bottom: 2rem;
            text-transform: uppercase;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            margin-bottom: 1.5rem;
            border-top: 1px solid var(--ink);
            padding-top: 0.5rem;
            display: inline-block;
        }

        p {
            font-size: 1.1rem;
            line-height: 1.4;
            max-width: 38ch;
            margin-bottom: 1.5rem;
        }

        
        .dense-list {
            list-style: none;
            font-size: 2.2rem;
            line-height: 1;
            font-weight: 400;
            letter-spacing: -0.02em;
        }
        .dense-list li {
            margin-bottom: 0.1em;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .dense-list li:hover {
            opacity: 0.5;
            text-decoration: underline;
            text-decoration-thickness: 2px;
        }
        .dense-list li span {
            display: block;
            font-size: 0.8rem;
            font-family: "Courier New", monospace;
            letter-spacing: 0;
            margin-bottom: 0.2rem;
            opacity: 0.6;
        }

        
        .slide-indicator {
            position: fixed;
            right: 6vw;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 100;
        }
        .dot {
            width: 6px;
            height: 6px;
            background: var(--ink);
            opacity: 0.2;
            transition: all 0.3s;
        }
        .dot.active {
            opacity: 1;
            transform: scale(1.5);
        }

        
        .btn-brutal {
            display: inline-block;
            border: 1px solid var(--ink);
            padding: 0.8rem 1.5rem;
            text-transform: uppercase;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            background: transparent;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
            margin-top: 2rem;
        }
        .btn-brutal:hover {
            background: var(--ink);
            color: var(--paper);
        }

        
        .qr-block {
            width: 80px;
            height: 80px;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"><rect width="10" height="10" fill="white"/><rect x="0" y="0" width="3" height="3" fill="black"/><rect x="7" y="0" width="3" height="3" fill="black"/><rect x="0" y="7" width="3" height="3" fill="black"/><rect x="4" y="4" width="2" height="2" fill="black"/><rect x="2" y="5" width="1" height="1" fill="black"/><rect x="6" y="2" width="1" height="1" fill="black"/></svg>');
            background-size: cover;
            image-rendering: pixelated;
            margin-top: auto;
        }

        
        .blink { animation: blinker 1.5s linear infinite; }
        @keyframes blinker { 50% { opacity: 0; } }

        
        #dynamic-image {
            transition: opacity 0.5s ease-in-out;
        }
    </style>
</head>
<body vid="6">

    <div id="deck-container" vid="7">
        
        
        <aside class="visual-panel" vid="8">
            <div class="reg-mark rm-tl" vid="9"></div>
            <div class="reg-mark rm-br" vid="10"></div>

            <div class="halftone-figure" vid="11">
                
                <img id="dynamic-image" src="data:image/jpeg;base64," alt="Swiss Landscape" vid="12">
                <div class="halftone-overlay" vid="13"></div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:flex-end;" vid="14">
                <div class="meta-data" vid="15">
                    STELLA MATUTINA<br vid="16">
                    FOUNDING: 2025
                </div>
            </div>
        </aside>

        
        <main class="content-panel" id="scroll-container" vid="17">
            
            
            <section id="slide-1" vid="18" style="background: var(--ink); color: var(--paper);">
                <h1 vid="19" style="font-size: 3.5rem;">Stella<br vid="20">Matutina</h1>
                <p vid="21" style="font-size: 1.3rem; max-width: 45ch;">
                    A school for discovering the new disciplines of an AI era
                </p>
            </section>

            
            <section id="slide-2" vid="22">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="23">THE OBSERVATION</div>
                <p vid="24" style="font-size: 1.3rem; max-width: 45ch;">
                    AI is too consequential to be shaped by any single discipline's assumptions — most of which were developed in the 20th century.
                </p>
                <p vid="25" style="font-size: 1.3rem; max-width: 45ch;">
                    Our reliance on old concepts creates volatility and estrangement from the most transformative technology of our time.
                </p>
            </section>

            
            <section id="slide-3" vid="26" style="background: var(--ink); color: var(--paper);">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="27">THE CONVICTION</div>
                <p vid="28" style="font-size: 1.3rem; max-width: 45ch; line-height: 1.5;">
                    Philosophy asks what AI changes about being human. Art tests what AI makes possible to create. Technology builds what philosophy and art can think with.
                </p>
                <p style="font-size: 1.3rem; max-width: 45ch; margin-top: 2rem;" vid="29">
                    Not as departments. As a single practice.
                </p>
            </section>

            
            <section id="slide-4" vid="30">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="31">THE FOUNDERS</div>
                <p vid="32" style="font-size: 1.3rem; max-width: 45ch; margin-bottom: 2rem;">
                    Built from fifteen years of creating the institutions where this actually happens.
                </p>
                <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-top: 2rem;" vid="33">
                    <div class="meta-data" style="border-top: 1px solid black; padding-top: 0.5rem;" vid="34">
                        TOBIAS REES<br vid="35">
                        Built research institutions at the frontier of philosophy, science, and art
                    </div>
                    <div class="meta-data" style="border-top: 1px solid black; padding-top: 0.5rem;" vid="36">
                        HALEY ALBERTS<br vid="37">
                        Designed the operational infrastructure to make them work
                    </div>
                    <div class="meta-data" style="border-top: 1px solid black; padding-top: 0.5rem;" vid="38">
                        SYLVAN RACKHAM<br vid="39">
                        Invested in frontier technology and built the networks that connect them
                    </div>
                </div>
            </section>

            
            <section id="slide-5" vid="40" style="background: var(--ink); color: var(--paper);">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="41">THE THESIS</div>
                <p vid="42" style="font-size: 1.3rem; max-width: 45ch; line-height: 1.5;">
                    Every discipline that exists today was born from a discovery that couldn't be contained by what came before.
                </p>
                <p style="font-size: 1.3rem; max-width: 45ch; margin-top: 2rem;" vid="43">
                    Stella is where the next ones begin.
                </p>
            </section>

            <section id="slide-6" vid="44">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="45">THE PLACE</div>
                <h2 vid="46">Stella Matutina,<br vid="47">Lake Lucerne,<br vid="48">Switzerland</h2>
                <p style="font-size: 1.1rem; max-width: 45ch;" vid="49">
                    A site with over a century-long legacy of future-thinking.
                </p>
            </section>

            <section id="slide-7" vid="50">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="51">THE PEOPLE</div>
                <p style="font-size: 1.3rem; max-width: 45ch; line-height: 1.5;" vid="52">
                    Fellows and faculty who've reached the limits of what existing institutions can offer.
                </p>
                <p style="font-size: 1.1rem; max-width: 45ch; margin-top: 2rem; line-height: 1.5;" vid="53">
                    The philosopher whose questions about agency aren't legible to a computer science department. The artist whose work with generative systems has no discipline to call home. The engineer who needs permission to think beyond optimisation.
                </p>
            </section>

            <section id="slide-8" vid="54">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="55">WHAT HAPPENS</div>
                <h2 vid="56">A site for open-ended experimentation</h2>
                <p style="font-size: 1.1rem; max-width: 45ch; line-height: 1.5;" vid="57">
                    Labs in philosophy, prototyping, and AI creativity. Salons with leading thinkers. Partnered R&amp;D institutions where experiments find live contexts. And the freedom to pursue questions that no existing discipline can house.
                </p>
            </section>

            <section id="slide-9" vid="58">
                <div class="meta-data" style="margin-bottom: 2rem;" vid="59">WHERE WE ARE</div>
                <p style="font-size: 1.3rem; max-width: 45ch; line-height: 1.5;" vid="60">
                    We are already in our research and outreach phase, which will culminate in a summer gathering of leading figures who are supporting Stella's mission.
                </p>
                <p style="font-size: 1.1rem; max-width: 45ch; margin-top: 2rem;" vid="61">
                    Our first cohort will run in Winter 2026, with full school in operation in Fall 2027.
                </p>
            </section>

            <section id="slide-10" style="background: var(--ink); color: var(--paper);" vid="62">
                <h1 style="font-size: 3.5rem; margin-bottom: 1rem;" vid="63">Stella<br vid="64">Matutina</h1>
                <div class="meta-data" style="font-size: 1rem; letter-spacing: 0.1em;" vid="65">stellamatutina.org</div>
            </section>

        </main>
    </div>

    
    <div class="slide-indicator" vid="66">
        <div class="dot active" vid="67"></div>
        <div class="dot" vid="68"></div>
        <div class="dot" vid="69"></div>
        <div class="dot" vid="70"></div>
        <div class="dot" vid="71"></div>
        <div class="dot" vid="72"></div>
        <div class="dot" vid="73"></div>
        <div class="dot" vid="74"></div>
        <div class="dot" vid="75"></div>
        <div class="dot" vid="76"></div>
    </div>

    <script vid="77">
        
        const container = document.getElementById('scroll-container');
        const dots = document.querySelectorAll('.dot');
        const img = document.getElementById('dynamic-image');
        const slides = document.querySelectorAll('section');
        
        
        const images = [
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,",
            "data:image/jpeg;base64,"
        ];

        container.addEventListener('scroll', () => {
            let current = '';
            
            slides.forEach((section, index) => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                
                if (container.scrollTop >= (sectionTop - sectionHeight / 3)) {
                    current = index;
                }
            });

            
            dots.forEach(dot => dot.classList.remove('active'));
            if(dots[current]) dots[current].classList.add('active');

            
            if (images[current] && img.src !== images[current]) {
                img.style.opacity = 0;
                setTimeout(() => {
                    img.src = images[current];
                    img.onload = () => {
                        img.style.opacity = 1;
                    };
                }, 200);
            }
        });

        
        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                slides[index].scrollIntoView({behavior: 'smooth'});
            });
        });
    </script>

</body></html>
